<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="SupplierClaimDefinitions" targetNamespace="http://cold-chain.example/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="SupplierClaimResolution" name="P6 Supplier claim resolution" isExecutable="true">
    <bpmn:startEvent id="Loss" name="Claimable loss recorded">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="LossDefinition" messageRef="Message_Loss" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Evidence" name="Assemble evidence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p6-assemble-evidence" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Submit" name="Submit simulated claim">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p6-submit-claim" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Response" name="Wait for supplier response">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ResponseDefinition" messageRef="Message_Response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Close" name="Record outcome and close">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="p6-close-claim" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Outcome" name="Supplier outcome" default="Flow_7">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Settled" name="Claim settled">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Rejected" name="Claim rejected">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Loss" targetRef="Evidence" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Evidence" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Submit" targetRef="Response" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Response" targetRef="Close" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Close" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Outcome" targetRef="Settled" name="Settled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= claimOutcome = "SETTLED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Outcome" targetRef="Rejected" name="Rejected" />
  </bpmn:process>
  <bpmn:message id="Message_Loss" name="ClaimableLossRecorded" />
  <bpmn:message id="Message_Response" name="SupplierResponseRecorded">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=claimId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="ClaimDiagram">
    <bpmndi:BPMNPlane id="ClaimPlane" bpmnElement="SupplierClaimResolution">
      <bpmndi:BPMNShape id="Loss_di" bpmnElement="Loss">
        <dc:Bounds x="75" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="28" y="173" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Evidence_di" bpmnElement="Evidence">
        <dc:Bounds x="165" y="108" width="108" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Submit_di" bpmnElement="Submit">
        <dc:Bounds x="320" y="108" width="108" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Response_di" bpmnElement="Response">
        <dc:Bounds x="490" y="130" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="443" y="173" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Close_di" bpmnElement="Close">
        <dc:Bounds x="590" y="108" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Outcome_di" bpmnElement="Outcome">
        <dc:Bounds x="755" y="123" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="715" y="180" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Settled_di" bpmnElement="Settled">
        <dc:Bounds x="890" y="65" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="843" y="108" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rejected_di" bpmnElement="Rejected">
        <dc:Bounds x="890" y="195" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="843" y="238" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="111" y="148" />
        <di:waypoint x="165" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="273" y="148" />
        <di:waypoint x="320" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="428" y="148" />
        <di:waypoint x="490" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="526" y="148" />
        <di:waypoint x="590" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="700" y="148" />
        <di:waypoint x="755" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="805" y="148" />
        <di:waypoint x="840" y="148" />
        <di:waypoint x="840" y="83" />
        <di:waypoint x="890" y="83" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="805" y="148" />
        <di:waypoint x="840" y="148" />
        <di:waypoint x="840" y="213" />
        <di:waypoint x="890" y="213" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
