# Optional. Copy to .env (untracked) and fill in to run the P4 investigation in the
# dcrgraphs.net repository; without these values P4 uses its local DCR engine.
# DCR_GRAPH_ID is the number in the dcrgraphs.net URL after importing dcr/p4_quality_investigation.xml.
DCR_GRAPH_ID=
DCR_USERNAME=
DCR_PASSWORD=
